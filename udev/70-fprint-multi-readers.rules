# Unified udev rules for ADST / BYD BF5325 (2009:7638 MOC), Betterlife (347d:0302 MOC & 347d:0304 MOH),
# ZKTeco ZK9500 (1b55:0124), and Chipsailing CS9711 (2541:0236):
# keep out of USB autosuspend, grant active session uaccess, and prevent usb-storage /dev/sr0
# fake CD-ROM binding on ADST 2009:7638.
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="2009", ATTR{idProduct}=="7638", TAG+="uaccess", ENV{ID_LIBFPRINT_DRIVER}="adst2009", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add|bind", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", ATTRS{idVendor}=="2009", ATTRS{idProduct}=="7638", DRIVER=="usb-storage", RUN+="/bin/sh -c 'echo -n $kernel > /sys/bus/usb/drivers/usb-storage/unbind'"
SUBSYSTEM=="block", ENV{ID_VENDOR_ID}=="2009", ENV{ID_MODEL_ID}=="7638", ENV{UDISKS_IGNORE}="1", OPTIONS+="nowatch"
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="347d", ATTR{idProduct}=="0302", TAG+="uaccess", ENV{ID_LIBFPRINT_DRIVER}="betterlife347d_moc", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="347d", ATTR{idProduct}=="0304", TAG+="uaccess", ENV{ID_LIBFPRINT_DRIVER}="betterlife347d", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1b55", ATTR{idProduct}=="0124", TAG+="uaccess", ENV{ID_LIBFPRINT_DRIVER}="zk9500", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="2541", ATTR{idProduct}=="0236", ENV{ID_LIBFPRINT_DRIVER}="cs9711", TEST=="power/control", ATTR{power/control}="on"
